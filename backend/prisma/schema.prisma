generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  orders    Order[]

  @@map("accounts")
}

enum OrderStatus {
  PENDING     // Chờ duyệt / Mới đặt từ Messenger
  CONFIRMED   // Đã xác nhận / Đang chuẩn bị hàng
  SHIPPING    // Đang giao hàng
  COMPLETED   // Đã hoàn thành
  CANCELLED   // Đã hủy
}

enum PaymentStatus {
  UNPAID      // Chưa thanh toán (COD)
  PAID        // Đã thanh toán
}

model Product {
  id                 String   @id @default(cuid())
  accountId          String   // Multi-tenant isolation
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // ĐỦ 6 TIÊU CHUẨN VÀNG CỦA META FACEBOOK SHOPPING:
  name               String   // 1. Tên sản phẩm
  category           String   @default("Mặc định") // 2. Danh mục
  description        String?  // 3. Mô tả tiếng Việt
  price              Decimal  @db.Decimal(12, 2)   // 4. Giá bán (> 0đ)
  stock              Int      @default(10)         // 5. Tồn kho (> 0)
  imageUrl           String?  // 6. Ảnh sản phẩm chuẩn vuông Meta (>= 500x500)

  // Mã định danh Pancake POS & Facebook
  sku                String?
  pancakeProductId   String?
  pancakeVariationId String?
  isSyncedToPos      Boolean  @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orderItems         OrderItem[]

  @@index([accountId])
  @@map("products")
}

model Order {
  id                 String        @id @default(cuid())
  accountId          String        // Multi-tenant isolation
  account            Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  code               String        // Mã đơn hiển thị (VD: DH-10023)
  customerName       String        // Tên khách hàng đặt từ Messenger
  customerPhone      String?       // Số điện thoại nhận hàng
  customerAddress    String?       // Địa chỉ giao hàng
  customerNote       String?       // Ghi chú của khách

  status             OrderStatus   @default(PENDING)
  paymentStatus      PaymentStatus @default(UNPAID)
  paymentMethod      String?       @default("COD") // COD, CHUYEN_KHOAN

  subtotal           Decimal       @db.Decimal(12, 2) // Tiền hàng
  shippingFee        Decimal       @default(0) @db.Decimal(12, 2) // Phí ship
  discount           Decimal       @default(0) @db.Decimal(12, 2) // Giảm giá
  totalAmount        Decimal       @db.Decimal(12, 2) // Tổng thanh toán

  pancakeOrderId     String?       // ID đơn trên Pancake POS
  source             String        @default("MESSENGER") // MESSENGER, POS, MANUAL

  items              OrderItem[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([accountId])
  @@index([pancakeOrderId])
  @@index([code])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productName  String   // Tên sản phẩm tại thời điểm đặt
  productImage String?  // Ảnh sản phẩm
  quantity     Int      @default(1)
  price        Decimal  @db.Decimal(12, 2) // Đơn giá
  total        Decimal  @db.Decimal(12, 2) // Thành tiền = price * quantity

  createdAt    DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}
